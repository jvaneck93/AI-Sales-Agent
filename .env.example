# Kopieer naar .env en vul in. Zet nooit echte sleutels in git.
DATABASE_URL=sqlite:///data/salesagent.db

# Harde regel 5: echte gesprekken alleen als dit expliciet op false staat.
DRY_RUN=true

# Harde regel 6: beltijden (werkdagen, Europe/Amsterdam)
CALL_WINDOW_START=09:00
CALL_WINDOW_END=17:00
CALL_TIMEZONE=Europe/Amsterdam
MAX_CALL_ATTEMPTS=3

# Vanaf fase 3 en 4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ELEVENLABS_API_KEY=
