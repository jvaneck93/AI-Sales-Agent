# Kopieer naar .env en vul in. Zet nooit echte sleutels in git.
# Lege sleutel = de sandbox (mock) wordt gebruikt. Alles werkt zonder sleutels.
DATABASE_URL=sqlite:///data/salesagent.db

# Harde regel 5: echte gesprekken alleen als dit expliciet op false staat.
DRY_RUN=true
# Nummers die nooit echt gebeld mogen worden (komma-gescheiden, E.164, bv. +31201234567).
TEST_BLOCK_NUMBERS=

# Harde regel 6: beltijden (werkdagen, Europe/Amsterdam)
CALL_WINDOW_START=09:00
CALL_WINDOW_END=17:00
CALL_TIMEZONE=Europe/Amsterdam
MAX_CALL_ATTEMPTS=3
# Minimaal aantal uren tussen twee pogingen bij hetzelfde bedrijf.
MIN_HOURS_BETWEEN_ATTEMPTS=24
# Belmoeheid over alle merken heen: maximaal aantal gesprekken per bedrijf per 90 dagen.
MAX_CONTACTS_PER_QUARTER=3

# Besluit 27-11-2026: alleen bv en nv koud bellen.
CALLABLE_LEGAL_FORMS=bv,nv

# Naam van het belbureau en de AI-agent in de AI-melding.
COMPANY_NAME=Belbureau
AGENT_NAME=Robin

# Anthropic: research (web search + web fetch) en analyse van opnames.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
RESEARCH_MAX_AGE_DAYS=30

# ElevenLabs Agents (uitgaand bellen via SIP-trunk).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Geheim van de post-call webhook (HMAC-handtekening).
ELEVENLABS_WEBHOOK_SECRET=
# Gedeeld geheim dat de agent meestuurt naar onze tools (header X-Tool-Secret).
TOOL_SECRET=

# KvK API (rechtsvorm per belronde). Zonder sleutel: mock-KvK, alleen geldig in de sandbox.
KVK_API_KEY=
KVK_API_BASE_URL=https://api.kvk.nl/api/v1

# Harde regel 7: bewaartermijnen in dagen (voorlopige standaardwaarden, open beslissing)
RETENTION_TRANSCRIPT_DAYS=90
RETENTION_CONTACT_DAYS=365
